# RecoverAI Environment Configuration

# Application Settings
PROJECT_NAME="RecoverAI"
VERSION="1.0.0"
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# Database Settings
DATABASE_URL="sqlite:///./data/recoverai.db"

# LLM Provider Configuration (Phase 5)
LLM_PROVIDER="mock"  # "mock" for zero-cost offline testing, "real" for Gemini/OpenAI API
LLM_MODEL_NAME="gemini-2.5-flash"
LLM_API_KEY="your_api_key_here"

# Razorpay Test Mode Credentials (Phase 7)
RAZORPAY_MODE="mock" # "mock" for offline testing, "test" for Razorpay Test Sandbox
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
